{
  "name": "@remote-youtube/chrome-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:background && pnpm build:content && node scripts/copy-extension.mjs",
    "build:background": "vite build --config vite.background.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "dev": "node scripts/watch-extension.mjs",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check src/**/*.ts manifest.json scripts/*.mjs"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.11",
    "@remote-youtube/protocol": "workspace:0.1.0"
  },
  "devDependencies": {
    "@types/chrome": "0.1.43",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
